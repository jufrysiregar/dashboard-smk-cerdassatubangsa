# Standalone demo build config.
# The app inherits a peer-dependency conflict from the source project
# (react-day-picker@8 expects date-fns ^2/^3, root pins date-fns@4).
# This makes a plain `npm install` (as Vercel/Netlify run it) succeed
# without needing the --legacy-peer-deps CLI flag.
legacy-peer-deps=true
